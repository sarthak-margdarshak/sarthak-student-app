{
  "expo": {
    "name": "Sarthak Margdarshak: Mock Test Guidance Guru",
    "description": "An app for students to appear mock-test of any competitive exam.",
    "slug": "sarthak-margdarshak-app",
    "owner": "sarthakmargdarshak",
    "version": "1.0.0",
    "platforms": ["ios", "android", "web"],
    "githubUrl": "https://github.com/sarthak-margdarshak/sarthak-student-app",
    "orientation": "portrait",
    "icon": "./assets/favicon/favicon-1024x1024.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash/splash-192x192.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFBFF"
    },
    "assetBundlePatterns": ["**/*"],
    "android": {
      "versionCode": 1,
      "userInterfaceStyle": "automatic",
      "icon": "./assets/favicon/favicon-1024x1024.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/favicon/favicon-1024x1024.png"
      },
      "splash": {
        "backgroundColor": "#FFFBFF",
        "resizeMode": "contain",
        "image": "./assets/splash/splash-192x192.png",
        "mdpi": "./assets/splash/splash-128x128.png",
        "hdpi": "./assets/splash/splash-180x180.png",
        "xhdpi": "./assets/splash/splash-256x256.png",
        "xxhdpi": "./assets/splash/splash-512x512.png",
        "xxxhdpi": "./assets/splash/splash-1024x1024.png",
        "dark": {
          "backgroundColor": "#181a20",
          "resizeMode": "contain",
          "image": "./assets/splash/splash-192x192.png",
          "mdpi": "./assets/splash/splash-128x128.png",
          "hdpi": "./assets/splash/splash-180x180.png",
          "xhdpi": "./assets/splash/splash-256x256.png",
          "xxhdpi": "./assets/splash/splash-512x512.png",
          "xxxhdpi": "./assets/splash/splash-1024x1024.png"
        }
      },
      "package": "com.sarthak.margdarshak.guidance"
    },
    "web": {
      "name": "Sarthak Margdarshak: Mock Test Guidance Guru",
      "short_name": "Sarthak",
      "display": "standalone",
      "start_url": "/",
      "favicon": "./assets/favicon/favicon-192x192.png",
      "themeColor": "#B62500",
      "backgroundColor": "#FFFBFF",
      "description": "An app for students to appear mock-test of any competitive exam.",
      "barStyle": "default",
      "splash": {
        "backgroundColor": "#FFFFE0",
        "resizeMode": "contain",
        "image": "./assets/splash/splash-192x192.png"
      },
      "bundler": "metro"
    },
    "scheme": "your-app-scheme",
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "97d97eab-a0b1-4903-b6d8-80d7a84edd27"
      }
    },
    "plugins": [
      [
        "expo-font",
        {
          "fonts": [
            "./public/assets/fonts/Laila-Bold.ttf",
            "./public/assets/fonts/Laila-Light.ttf",
            "./public/assets/fonts/Laila-Medium.ttf",
            "./public/assets/fonts/Laila-Regular.ttf",
            "./public/assets/fonts/Laila-SemiBold.ttf"
          ]
        }
      ],
      [
        "expo-router",
        {
          "root": "./src/app"
        }
      ]
    ]
  }
}
